    {
      "content": [
        {
          "text": "The standard error shrinks with ",
          "type": "text"
        },
        {
          "tex": "\\sqrt{n}",
          "type": "math"
        },
        {
          "text": ", so four times the sample halves it.",
          "type": "text"
