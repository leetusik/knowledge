      "type": "heading"
    },
    {
      "alt": "t equals x bar minus mu, over s divided by the square root of n.",
      "id": "tstat",
      "reading": [
        {
          "text": "The t statistic counts how many standard errors the sample mean sits from the mean you assumed.",
          "type": "text"
        }
      ],
      "tex": "t = \\frac{\\bar{x} - \\mu}{s / \\sqrt{n}}\n",
      "type": "formula",
      "where": [
        {
          "means": [
            {
              "text": "the ",
              "type": "text"
