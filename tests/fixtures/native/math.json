      ],
      "tex": "\\begin{aligned}\n\\lambda &= \\mathrm{rate} \\times \\mathrm{time} \\\\\n&= 3 \\times 2 \\\\\n&= 6\n\\end{aligned}\n",
      "type": "formula",
      "where": [
