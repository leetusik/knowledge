<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Listen runner (P41-sr.B3). install.sh fills the @...@ paths; the operator installs it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.knowledge.listen-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>@RUNNER_DIR@/.venv/bin/python</string>
    <string>-m</string>
    <string>listen_runner</string>
    <string>--env-file</string>
    <string>@RUNNER_DIR@/.env</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@RUNNER_DIR@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
</dict>
</plist>
