# Copy to tools/listen-runner/.env (gitignored) and fill in. Never commit the filled file.

# The knowledge server's origin, e.g. https://knowledge.example.com (no trailing slash).
KB_LISTEN_URL=
# An org-level vk_ key (minted at /app/credentials). Never printed or logged.
KB_LISTEN_KEY=

# Optional (defaults shown in the README):
# KB_LISTEN_POLL_S=30
# KB_LISTEN_PAUSE_S=0.35
# KB_LISTEN_SECTION_PAUSE_S=0.9
# KB_LISTEN_SENTENCE_PAUSE_S=0.1
# KB_LISTEN_IDLE_UNLOAD_S=1800
# KB_LISTEN_SEED=0
# KB_LISTEN_MODEL=mlx-community/Ming-3.0-tts-0.5B-bf16
# KB_LISTEN_FFMPEG=/opt/homebrew/bin/ffmpeg
