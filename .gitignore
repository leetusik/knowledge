.DS_Store
site/
.cache/
/data/
# Namespaced, non-published content root for non-#1 tenants (S5). On-box only:
# never git-published, never served by mkdocs. NOTE: this means non-#1 tenant
# content has no git backup — see the deferred per-tenant backup job.
/tenants/
# Chapter images (P30.S4, decision A2): <root>/.assets/ under EVERY tenant root,
# tenant #1's docs/ included, lives on the box disk only and is never committed.
# server/assets.py also drops a self-ignoring .assets/.gitignore, and gitops.add
# refuses the path, so this line is one of three guards.
.assets/
__pycache__/
*.py[co]
.venv/
.env

# Private keys must NEVER enter this repo (it is public). The git push deploy key
# is generated ON THE BOX, in its final location, and its private half never
# leaves it — see deploy/SECRETS.md §2. These patterns are a backstop against an
# accidental `git add -A`, not a place to put a key.
knowledge_deploy_key*
*.pem
*.key
