{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/workflow.py:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(cp:*)",
      "Bash(command -v:*)",
      "Bash(knowledge config:*)",
      "Bash(knowledge guide:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/workflow.py compact-gate || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/workflow.py compact-resume || true",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 500000
}
